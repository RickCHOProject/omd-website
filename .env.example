# ===========================
# OMD V2 Platform Environment
# ===========================

# FRED API (Federal Reserve Economic Data)
# Get a free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Used for: Market Dashboard live data
FRED_API_KEY=your_fred_api_key_here

# Refresh endpoint security (optional)
# If set, POST /api/refresh-market-data requires Bearer token
REFRESH_SECRET=your_secret_here

# Supabase (Phase 4b - future)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
